# syntax=docker/dockerfile:1.10
# Build only from launch --prepare's bounded context, after explicit approval.
FROM rust:1.89.0-slim-bookworm@sha256:d7fc7de78bb8c1469933aeecbf801314d30d7d6e9f0578bba4cfa285bfa37fe6 AS rust
FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db AS builder
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup
ENV PATH=/usr/local/cargo/bin:/opt/venv/bin:$PATH
RUN apt-get update && apt-get install -y --no-install-recommends build-essential=12.9
RUN pip install --no-cache-dir uv==0.7.2 && uv venv --python /usr/local/bin/python /opt/venv
WORKDIR /src
COPY source/ /src/
RUN --mount=type=secret,id=uv_config,target=/run/secrets/uv.toml,required=true \
    --mount=type=secret,id=space_tools_username,env=UV_INDEX_SPACE_TOOLS_USERNAME,required=true \
    --mount=type=secret,id=space_tools_password,env=UV_INDEX_SPACE_TOOLS_PASSWORD,required=true \
    uv --config-file /run/secrets/uv.toml pip install --python /opt/venv/bin/python \
    --require-hashes -r deploy/zenml/moe_iceland/requirements-runtime.txt
# Only installed wheels and their receipt enter the final image, not this source tree.
RUN python -m deploy.zenml.moe_iceland.build_workspace
RUN PYTHONDONTWRITEBYTECODE=1 ZENML_ANALYTICS_OPT_IN=false \
    python -m deploy.zenml.moe_iceland.provenance --root /src --output /opt/moe-image.json

FROM python:3.12.10-slim-bookworm@sha256:fd95fa221297a88e1cf49c55ec1828edd7c5a428187e67b5d1805692d11588db
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/moe-image.json /opt/moe-image.json
ENV PATH=/opt/venv/bin:$PATH PYTHONDONTWRITEBYTECODE=1
ENV ZENML_CONFIG_PATH=/tmp/moe-zenml ZENML_ANALYTICS_OPT_IN=false
ENV HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN groupadd --gid 1000 moe && useradd --uid 1000 --gid 1000 --create-home moe \
    && mkdir /app && chown 1000:1000 /app
WORKDIR /app
USER 1000:1000
CMD ["python", "-c", "print('Use the isolated Iceland launcher and its verified source archive.')"]