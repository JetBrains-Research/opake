      <excludeFolder url="file://$MODULE_DIR$/site" />
      <excludeFolder url="file://$MODULE_DIR$/target" />
      <excludeFolder url="file://$MODULE_DIR$/trainer_output" />
    </content>
    <orderEntry type="jdk" jdkName="~/work/opaque/.venv" jdkType="Python SDK" />
    <orderEntry type="sourceFolder" forTests="false" />
    <orderEntry type="module" module-name="opaque-dpsgd" exported="" />
    <orderEntry type="module" module-name="opaque-engine" exported="" />
    <orderEntry type="module" module-name="opaque-optimizers" exported="" />
